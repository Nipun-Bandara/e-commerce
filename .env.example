# Copy to .env and fill in real values: cp .env.example .env
# Every variable the app reads is listed here. Keep this file in sync when you add one.

# ---- Database -------------------------------------------------------------
# Postgres connection string. Used by Prisma for migrations, seeding, Studio
# and at runtime. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://ecom:ecom@localhost:5433/ecom?schema=public"

# ---- App ------------------------------------------------------------------
# Public base URL the app is served from. Used for absolute links and metadata,
# and — because PayHere has to reach them from the internet — for the return,
# cancel and notify URLs sent to the payment gateway.
#
# While testing payments locally this must be the public tunnel URL, not
# localhost: PayHere cannot call back to your machine otherwise. See the
# "Testing the webhook locally" section of the README.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ISO 4217 currency code. The store prices everything in Sri Lankan Rupees.
NEXT_PUBLIC_CURRENCY="LKR"

# ---- Authentication -------------------------------------------------------
# Secret Auth.js uses to sign and encrypt the session JWT. Required in every
# environment — the app will not start without it. Generate your own with:
#   openssl rand -base64 32
# Changing it invalidates every session that is currently signed in.
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# ---- Payments (PayHere) ---------------------------------------------------
# Credentials for the PayHere checkout gateway. Create a sandbox merchant
# account at https://sandbox.payhere.lk, then read both values from
# Settings -> Domains & Credentials. The secret is shown against an approved
# domain or app, so add your tunnel/deployment domain there first.
#
# Optional. The app builds and runs without them: with no credentials the
# payment step renders "payments are not configured" and the notify webhook
# answers 500, and nothing else in the app is affected.
#
# PAYHERE_MERCHANT_SECRET is what makes a forged payment notification
# impossible. It is read only by `src/lib/payhere.ts`, which is `server-only`,
# so it never reaches the browser. Never give it a NEXT_PUBLIC_ prefix.
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""

# Which PayHere to talk to: sandbox (test cards, no money) or live (real cards).
# Anything other than the exact string "false" means sandbox, so an unset or
# misspelled value cannot silently start charging real cards.
PAYHERE_SANDBOX=true

# ---- Image uploads --------------------------------------------------------
# UploadThing token for admin product images. Create a free app at
# https://uploadthing.com, then copy the token from its API Keys tab — it is a
# base64 JSON blob holding the API key, the app id and the storage regions.
#
# Optional. The app builds and runs without it: with no token the admin image
# panel falls back to pasting image URLs instead of uploading files, which is
# also how the seeded picsum.photos images got there. Set it to upload files.
#
# Uploaded files are served from https://<appId>.ufs.sh/f/<key>, which is why
# next.config.ts allows that host — a new token means a new app id, and the
# wildcard in that pattern is what keeps this from being two places to edit.
UPLOADTHING_TOKEN=""
